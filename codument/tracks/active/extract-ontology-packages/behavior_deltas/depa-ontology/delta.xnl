<BehaviorPatch #track.extract-ontology-packages.behavior_patch.depa-ontology apiVersion="codument.tech/v1alpha1" version="1" { capability = "depa-ontology" } (
  <Mutations [
    <Upsert { selector = "behavior://depa-ontology/requirements/package-boundaries" } (
      <Requirement #package-boundaries (
        <Statement ?01M1W0XR5JG2VGKWCMXTTTXEAE>
        系统 SHALL 将可移植 Datalog DSL 发布为 depa-datalog，并将对象建模运行时发布为 depa-ontology；后者 SHALL 依赖 npm 上的 depa-cozo@0.1.0，且不得包含原生数据库加载实现。
        </?01M1W0XR5JG2VGKWCMXTTTXEAE>
        <Suites [
          <Suite #workspace-install { name = "工作区安装与运行" } (
            <Cases [
              <Case #ontology-tests-use-published-binding (
                <Given ?01M1W0XR5JG2VGKWCMXTTTXEAF>
                应用在 Bun 工作区安装 depa-ontology 和其依赖
                </?01M1W0XR5JG2VGKWCMXTTTXEAF>
                <When ?01M1W0XR5JG2VGKWCMXTTTXEAG>
                运行对象建模测试
                </?01M1W0XR5JG2VGKWCMXTTTXEAG>
                <Then ?01M1W0XR5JG2VGKWCMXTTTXEAH>
                系统 SHALL 从 depa-cozo 获得 CozoDb 与 CozoTx，并通过全部对象建模与 DSL 测试
                </?01M1W0XR5JG2VGKWCMXTTTXEAH>
              )>
            ]>
          )>
        ]>
      )>
    )>
  ]>
)>
