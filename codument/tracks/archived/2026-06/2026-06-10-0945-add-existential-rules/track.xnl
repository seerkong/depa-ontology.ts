              <Criterion { id = "T2.2-AC2" checked = true } ?01M1W0XR6MPEKMAGYZ2F63MPNJ>
              retract 边计为缺失；asOf 时点检测与 NOW 结果按时间线一致
              </?01M1W0XR6MPEKMAGYZ2F63MPNJ>
            ]>
            <SubNodes [
              <Task { id = "T2.2.1" name = "编写测试：where 过滤 + retract + asOf（om-existential-temporal.test.js）" status = "DONE" order = 0 }>
              <Task { id = "T2.2.2" name = "实现：where 编译与 asOf 透传" status = "DONE" order = 1 }>
            ]>
          )>
        ]>
      )>
      <TaskGroup #P3 { name = "Skolem chase applyExistentialRules" status = "DONE" order = 2 } (
        <Description ?01M1W0XR6MPEKMAGYZ2F63MPNK>
