<BehaviorPatch #track.r_2_0_2_6_-_0_6_-_1_0_-_0_9_4_5_-_a_d_d_-_e_x_i_s_t_e_n_t_i_a_l_-_r_u_l_e_s.behavior_patch.cozo-lib-bun-viz apiVersion="codument.tech/v1alpha1" version="1" { capability = "cozo-lib-bun-viz" } (
  <Mutations [
    <Upsert { selector = "behavior://cozo-lib-bun-viz/requirements/viz-007-governance-integrity-tab" } (
      <Requirement #viz-007-governance-integrity-tab (
        <Statement ?01M1W0XR6D6HDT7TGFC3Z874GF>
        系统 SHALL 在 /governance 页面新增「完整性检查」子 tab，演示存在规则的违例检测与 Skolem chase 物化：展示规则列表与违例结果，并支持一键执行物化后展示 created 结果与刷新后的违例列表。现有子 tab（数据准备、权限查询）与旧 /permission demo 的行为 SHALL NOT 改变。server 端 SHALL 提供对应 API 端点（列出规则、执行违例检测、执行 chase 物化）。新增能力 SHALL 具备单元测试与 Playwright E2E 覆盖，并通过既有门控命令（bun test、bun test --coverage、codument validate --strict、npm run test:e2e）。
        </?01M1W0XR6D6HDT7TGFC3Z874GF>
        <Suites [
          <Suite #integrity-tab { name = "完整性检查子 tab" } (
            <Cases [
              <Case #tab-shows-violations (
                <Given ?01M1W0XR6D6HDT7TGFC3Z874GG>
                用户进入 /governance 的「完整性检查」子 tab，演示数据含存在规则违例
                </?01M1W0XR6D6HDT7TGFC3Z874GG>
                <When ?01M1W0XR6D6HDT7TGFC3Z874GH>
                执行违例检测
                </?01M1W0XR6D6HDT7TGFC3Z874GH>
                <Then ?01M1W0XR6D6HDT7TGFC3Z874GJ>
                页面展示规则列表与违例实体列表（含规则名与提示消息）
                </?01M1W0XR6D6HDT7TGFC3Z874GJ>
              )>
              <Case #chase-materializes-and-clears (
                <Given ?01M1W0XR6D6HDT7TGFC3Z874GK>
                违例列表非空且存在 materialize 规则
                </?01M1W0XR6D6HDT7TGFC3Z874GK>
                <When ?01M1W0XR6D6HDT7TGFC3Z874GM>
                用户点击一键物化
                </?01M1W0XR6D6HDT7TGFC3Z874GM>
                <Then ?01M1W0XR6D6HDT7TGFC3Z874GN>
                页面展示 created 结果（Skolem 实体与新边），重新检测后对应违例消失
                </?01M1W0XR6D6HDT7TGFC3Z874GN>
              )>
              <Case #existing-tabs-unaffected (
                <Given ?01M1W0XR6D6HDT7TGFC3Z874GP>
                用户访问 /governance 的数据准备与权限查询子 tab，以及 /permission 页面
                </?01M1W0XR6D6HDT7TGFC3Z874GP>
                <When ?01M1W0XR6D6HDT7TGFC3Z874GQ>
                执行既有交互流程
                </?01M1W0XR6D6HDT7TGFC3Z874GQ>
                <Then ?01M1W0XR6D6HDT7TGFC3Z874GR>
                行为与新增「完整性检查」tab 之前一致
                </?01M1W0XR6D6HDT7TGFC3Z874GR>
              )>
            ]>
          )>
        ]>
      )>
    )>
  ]>
)>
