<BehaviorPatch #track.r_2_0_2_6_-_0_6_-_1_0_-_0_9_4_5_-_a_d_d_-_e_x_i_s_t_e_n_t_i_a_l_-_r_u_l_e_s.behavior_patch.depa-ontology apiVersion="codument.tech/v1alpha1" version="1" { capability = "depa-ontology" } (
  <Mutations [
    <Upsert { selector = "behavior://depa-ontology/requirements/om-024-existential-rule-definition" } (
      <Requirement #om-024-existential-rule-definition (
        <Statement ?01M1W0XR6FQWRKB3R3F0AZ46X0>
        系统 SHALL 提供 defineExistentialRule(runner, ruleName, spec) 用于声明式定义存在规则，并持久化到存储关系 om_existential_rule_def（rule_name => spec(Json), mode, message, enabled）。规则 spec SHALL 包含 forEach（body：type，可选 where 属性条件列表）与 exists（head：rel、可选 direction、toType）。v1 head 形态 SHALL 仅支持「∃ 关系边 + 目标实体」。mode SHALL 支持 'check'（默认）与 'materialize'。规则中引用的 type/rel/attr 名称 SHALL 经 alias 解析为 canonical 名称。initSchema SHALL 幂等创建 om_existential_rule_def。系统 SHALL 提供 listExistentialRules(runner) 返回全部规则定义。
        </?01M1W0XR6FQWRKB3R3F0AZ46X0>
        <Suites [
          <Suite #definition { name = "规则定义与持久化" } (
            <Cases [
              <Case #define-and-persist (
                <Given ?01M1W0XR6FQWRKB3R3F0AZ46X1>
                数据库已 initSchema，且已定义类型 Order、Shipment 与关系 has_shipment
                </?01M1W0XR6FQWRKB3R3F0AZ46X1>
                <When ?01M1W0XR6FQWRKB3R3F0AZ46X2>
                调用 defineExistentialRule(runner, 'order_must_have_shipment', { forEach: { type: 'Order' }, exists: { rel: 'has_shipment', toType: 'Shipment' }, mode: 'check' })
                </?01M1W0XR6FQWRKB3R3F0AZ46X2>
                <Then ?01M1W0XR6FQWRKB3R3F0AZ46X3>
                om_existential_rule_def 中持久化该规则，listExistentialRules 返回包含该规则的结果
                </?01M1W0XR6FQWRKB3R3F0AZ46X3>
              )>
              <Case #reject-invalid-spec (
                <Given ?01M1W0XR6FQWRKB3R3F0AZ46X4>
                数据库已 initSchema
                </?01M1W0XR6FQWRKB3R3F0AZ46X4>
                <When ?01M1W0XR6FQWRKB3R3F0AZ46X5>
                调用 defineExistentialRule 时 spec 缺少 exists.rel 或 exists.toType，或引用了不存在的类型/关系，或 where 条目缺少 value（undefined）
                </?01M1W0XR6FQWRKB3R3F0AZ46X5>
                <Then ?01M1W0XR6FQWRKB3R3F0AZ46X6>
                系统返回错误且不写入规则
                </?01M1W0XR6FQWRKB3R3F0AZ46X6>
              )>
              <Case #redefine-upsert (
                <Given ?01M1W0XR6FQWRKB3R3F0AZ46X7>
                规则 r1 已定义
                </?01M1W0XR6FQWRKB3R3F0AZ46X7>
                <When ?01M1W0XR6FQWRKB3R3F0AZ46X8>
                以相同 ruleName 再次调用 defineExistentialRule 且 spec 不同
                </?01M1W0XR6FQWRKB3R3F0AZ46X8>
                <Then ?01M1W0XR6FQWRKB3R3F0AZ46X9>
                规则定义被更新（upsert 语义），listExistentialRules 返回新 spec
                </?01M1W0XR6FQWRKB3R3F0AZ46X9>
              )>
              <Case #alias-canonicalized-on-define (
                <Given ?01M1W0XR6FQWRKB3R3F0AZ46XA>
                类型 Order 存在 alias 旧名 PurchaseOrder
                </?01M1W0XR6FQWRKB3R3F0AZ46XA>
                <When ?01M1W0XR6FQWRKB3R3F0AZ46XB>
                以 forEach.type = 'PurchaseOrder' 定义规则
                </?01M1W0XR6FQWRKB3R3F0AZ46XB>
                <Then ?01M1W0XR6FQWRKB3R3F0AZ46XC>
                规则持久化时 type 引用被解析为 canonical 名称 Order
                </?01M1W0XR6FQWRKB3R3F0AZ46XC>
              )>
              <Case #init-schema-idempotent (
                <Given ?01M1W0XR6FQWRKB3R3F0AZ46XD>
                数据库已 initSchema 且已存在规则定义
                </?01M1W0XR6FQWRKB3R3F0AZ46XD>
                <When ?01M1W0XR6FQWRKB3R3F0AZ46XE>
                再次调用 initSchema(runner)
                </?01M1W0XR6FQWRKB3R3F0AZ46XE>
                <Then ?01M1W0XR6FQWRKB3R3F0AZ46XF>
                om_existential_rule_def 与既有规则定义保持不变
                </?01M1W0XR6FQWRKB3R3F0AZ46XF>
              )>
            ]>
          )>
        ]>
      )>
    )>
    <Upsert { selector = "behavior://depa-ontology/requirements/om-025-existential-violation-check" } (
      <Requirement #om-025-existential-violation-check (
        <Statement ?01M1W0XR6FQWRKB3R3F0AZ46XG>
        系统 SHALL 提供 checkExistentialRules(runner, options?) 以集合语义检测存在规则违例：对每条 enabled 规则，找出满足 forEach（type 闭包含子类型实例；where 条件按 om_property 当前快照求值）但不存在满足 exists 的关系边（om_edge 按 @NOW 语义判定，目标实体类型在 toType 闭包内）的实体。返回 SHALL 为 [{ rule, entityId, message }] 列表。options SHALL 支持 rules（规则名过滤）与 asOf（按历史时间点检测）。disabled 规则 SHALL 被跳过。
        </?01M1W0XR6FQWRKB3R3F0AZ46XG>
        <Suites [
          <Suite #violation-check { name = "违例检测" } (
            <Cases [
              <Case #detect-missing-edge (
                <Given ?01M1W0XR6FQWRKB3R3F0AZ46XH>
                规则 order_must_have_shipment 已定义，实体 o1（Order）无 has_shipment 出边
                </?01M1W0XR6FQWRKB3R3F0AZ46XH>
                <When ?01M1W0XR6FQWRKB3R3F0AZ46XJ>
                调用 checkExistentialRules(runner)
                </?01M1W0XR6FQWRKB3R3F0AZ46XJ>
                <Then ?01M1W0XR6FQWRKB3R3F0AZ46XK>
                返回包含 { rule: 'order_must_have_shipment', entityId: 'o1' } 的违例
                </?01M1W0XR6FQWRKB3R3F0AZ46XK>
              )>
              <Case #satisfied-not-reported (
                <Given ?01M1W0XR6FQWRKB3R3F0AZ46XM>
                实体 o2（Order）已有指向 Shipment 实例的 has_shipment 边
                </?01M1W0XR6FQWRKB3R3F0AZ46XM>
                <When ?01M1W0XR6FQWRKB3R3F0AZ46XN>
                调用 checkExistentialRules(runner)
                </?01M1W0XR6FQWRKB3R3F0AZ46XN>
                <Then ?01M1W0XR6FQWRKB3R3F0AZ46XP>
                o2 不出现在违例列表中
                </?01M1W0XR6FQWRKB3R3F0AZ46XP>
              )>
              <Case #polymorphic-body-and-head (
                <Given ?01M1W0XR6FQWRKB3R3F0AZ46XQ>
                RushOrder 继承自 Order，ExpressShipment 继承自 Shipment；实体 ro1（RushOrder）有指向 ExpressShipment 实例的 has_shipment 边，实体 ro2（RushOrder）无该边
                </?01M1W0XR6FQWRKB3R3F0AZ46XQ>
                <When ?01M1W0XR6FQWRKB3R3F0AZ46XR>
                调用 checkExistentialRules(runner)
                </?01M1W0XR6FQWRKB3R3F0AZ46XR>
                <Then ?01M1W0XR6FQWRKB3R3F0AZ46XS>
                ro2 被报告为违例且 ro1 不被报告（body 与 head 类型匹配均含子类型）
                </?01M1W0XR6FQWRKB3R3F0AZ46XS>
              )>
              <Case #where-condition-filters-body (
                <Given ?01M1W0XR6FQWRKB3R3F0AZ46XT>
                规则 forEach.where 为 [{ attr: 'status', op: '=', value: 'confirmed' }]，实体 o3 状态为 draft 且无 has_shipment 边
                </?01M1W0XR6FQWRKB3R3F0AZ46XT>
                <When ?01M1W0XR6FQWRKB3R3F0AZ46XV>
                调用 checkExistentialRules(runner)
                </?01M1W0XR6FQWRKB3R3F0AZ46XV>
                <Then ?01M1W0XR6FQWRKB3R3F0AZ46XW>
                o3 不被报告为违例
                </?01M1W0XR6FQWRKB3R3F0AZ46XW>
              )>
              <Case #retracted-edge-is-missing (
                <Given ?01M1W0XR6FQWRKB3R3F0AZ46XX>
                实体 o4 的 has_shipment 边已在更早 validTime 被 retract
                </?01M1W0XR6FQWRKB3R3F0AZ46XX>
                <When ?01M1W0XR6FQWRKB3R3F0AZ46XY>
                调用 checkExistentialRules(runner)
                </?01M1W0XR6FQWRKB3R3F0AZ46XY>
                <Then ?01M1W0XR6FQWRKB3R3F0AZ46XZ>
                o4 被报告为违例（@NOW 语义下边不存在）
                </?01M1W0XR6FQWRKB3R3F0AZ46XZ>
              )>
              <Case #as-of-historical-check (
                <Given ?01M1W0XR6FQWRKB3R3F0AZ46Y0>
                实体 o5 的 has_shipment 边在 T1 之后才被 assert
                </?01M1W0XR6FQWRKB3R3F0AZ46Y0>
                <When ?01M1W0XR6FQWRKB3R3F0AZ46Y1>
                调用 checkExistentialRules(runner, { asOf: T0 })（T0 早于 T1）
                </?01M1W0XR6FQWRKB3R3F0AZ46Y1>
                <Then ?01M1W0XR6FQWRKB3R3F0AZ46Y2>
                o5 在 T0 时点被报告为违例，而不带 asOf 调用时不被报告
                </?01M1W0XR6FQWRKB3R3F0AZ46Y2>
              )>
            ]>
          )>
        ]>
      )>
    )>
    <Upsert { selector = "behavior://depa-ontology/requirements/om-026-existential-skolem-chase" } (
      <Requirement #om-026-existential-skolem-chase (
        <Statement ?01M1W0XR6FQWRKB3R3F0AZ46Y3>
        系统 SHALL 提供 applyExistentialRules(runner, options?) 对 mode='materialize' 的规则执行 Skolem chase：循环检测违例并为每个违例实体物化目标实体与关系边，直至不动点或 maxIterations（默认 10）。Skolem 实体 ID SHALL 由规则名与触发实体 ID 的确定性哈希生成；物化 SHALL 幂等（重复执行不产生重复对象）。物化前 SHALL 先检查满足性，已满足（含人工补录）的实体 SHALL NOT 被物化。Skolem 实体 SHALL 写入内置属性 _skolem_rule 标记来源规则。options.validTime SHALL 透传给实体属性与关系边写入。返回 SHALL 包含 { created, iterations, reachedFixpoint }；达到 maxIterations 仍未收敛时 reachedFixpoint SHALL 为 false 并附诊断。
        </?01M1W0XR6FQWRKB3R3F0AZ46Y3>
        <Suites [
          <Suite #skolem-chase { name = "Skolem chase 物化" } (
            <Cases [
              <Case #materialize-creates-entity-and-edge (
                <Given ?01M1W0XR6FQWRKB3R3F0AZ46Y4>
                materialize 规则已定义，实体 o1（Order）无 has_shipment 边
                </?01M1W0XR6FQWRKB3R3F0AZ46Y4>
                <When ?01M1W0XR6FQWRKB3R3F0AZ46Y5>
                调用 applyExistentialRules(runner)
                </?01M1W0XR6FQWRKB3R3F0AZ46Y5>
                <Then ?01M1W0XR6FQWRKB3R3F0AZ46Y6>
                系统创建 Shipment 类型的 Skolem 实体并建立 o1 到该实体的 has_shipment 边，created 包含该记录且后续 checkExistentialRules 不再报告 o1
                </?01M1W0XR6FQWRKB3R3F0AZ46Y6>
              )>
              <Case #skolem-marked-with-rule (
                <Given ?01M1W0XR6FQWRKB3R3F0AZ46Y7>
                chase 已为 o1 物化 Skolem 实体 s1
                </?01M1W0XR6FQWRKB3R3F0AZ46Y7>
                <When ?01M1W0XR6FQWRKB3R3F0AZ46Y8>
                读取 s1 的属性 _skolem_rule
                </?01M1W0XR6FQWRKB3R3F0AZ46Y8>
                <Then ?01M1W0XR6FQWRKB3R3F0AZ46Y9>
                返回来源规则名
                </?01M1W0XR6FQWRKB3R3F0AZ46Y9>
              )>
              <Case #idempotent-rerun (
                <Given ?01M1W0XR6FQWRKB3R3F0AZ46YA>
                chase 已执行一次并物化了 Skolem 实体
                </?01M1W0XR6FQWRKB3R3F0AZ46YA>
                <When ?01M1W0XR6FQWRKB3R3F0AZ46YB>
                再次调用 applyExistentialRules(runner)
                </?01M1W0XR6FQWRKB3R3F0AZ46YB>
                <Then ?01M1W0XR6FQWRKB3R3F0AZ46YC>
                不产生新实体或新边，created 为空且 reachedFixpoint 为 true
                </?01M1W0XR6FQWRKB3R3F0AZ46YC>
              )>
              <Case #manual-fix-respected (
                <Given ?01M1W0XR6FQWRKB3R3F0AZ46YD>
                实体 o2 的违例已由人工补录真实 Shipment 边修复
                </?01M1W0XR6FQWRKB3R3F0AZ46YD>
                <When ?01M1W0XR6FQWRKB3R3F0AZ46YE>
                调用 applyExistentialRules(runner)
                </?01M1W0XR6FQWRKB3R3F0AZ46YE>
                <Then ?01M1W0XR6FQWRKB3R3F0AZ46YF>
                o2 不被物化 Skolem 实体
                </?01M1W0XR6FQWRKB3R3F0AZ46YF>
              )>
              <Case #iteration-cap-with-diagnostics (
                <Given ?01M1W0XR6FQWRKB3R3F0AZ46YG>
                两条 materialize 规则构成循环依赖（A 物化的实体触发 B，B 物化的实体触发 A）
                </?01M1W0XR6FQWRKB3R3F0AZ46YG>
                <When ?01M1W0XR6FQWRKB3R3F0AZ46YH>
                调用 applyExistentialRules(runner, { maxIterations: 3 })
                </?01M1W0XR6FQWRKB3R3F0AZ46YH>
                <Then ?01M1W0XR6FQWRKB3R3F0AZ46YJ>
                chase 在 3 轮后停止，reachedFixpoint 为 false 且返回包含未收敛规则的诊断
                </?01M1W0XR6FQWRKB3R3F0AZ46YJ>
              )>
              <Case #valid-time-applied (
                <Given ?01M1W0XR6FQWRKB3R3F0AZ46YK>
                materialize 规则已定义且存在违例实体
                </?01M1W0XR6FQWRKB3R3F0AZ46YK>
                <When ?01M1W0XR6FQWRKB3R3F0AZ46YM>
                调用 applyExistentialRules(runner, { validTime: T })
                </?01M1W0XR6FQWRKB3R3F0AZ46YM>
                <Then ?01M1W0XR6FQWRKB3R3F0AZ46YN>
                物化的关系边与属性以 validTime=T 写入，getNeighborsAsOf 在 T 之前查不到该边
                </?01M1W0XR6FQWRKB3R3F0AZ46YN>
              )>
              <Case #check-mode-rules-not-materialized (
                <Given ?01M1W0XR6FQWRKB3R3F0AZ46YP>
                同时存在 mode='check' 与 mode='materialize' 的规则且各有违例
                </?01M1W0XR6FQWRKB3R3F0AZ46YP>
                <When ?01M1W0XR6FQWRKB3R3F0AZ46YQ>
                调用 applyExistentialRules(runner)
                </?01M1W0XR6FQWRKB3R3F0AZ46YQ>
                <Then ?01M1W0XR6FQWRKB3R3F0AZ46YR>
                仅 materialize 规则的违例被物化，check 规则的违例保持不变
                </?01M1W0XR6FQWRKB3R3F0AZ46YR>
              )>
            ]>
          )>
        ]>
      )>
    )>
    <Upsert { selector = "behavior://depa-ontology/requirements/om-027-existential-governance-integration" } (
      <Requirement #om-027-existential-governance-integration (
        <Statement ?01M1W0XR6FQWRKB3R3F0AZ46YS>
        存在规则子系统 SHALL 与既有治理机制集成：om_existential_rule_def SHALL 纳入 schema snapshot 范围并参与 diffSchemaVersions 与 rollbackSchema 恢复；规则中的 type/rel/attr 引用 SHALL 经 alias 解析在 schema 重命名后继续工作；chase 与违例检测 SHALL 为系统级操作，不经过 checkAccess 权限过滤；未定义任何存在规则时，既有 API 行为 SHALL 与引入本子系统前一致。
        </?01M1W0XR6FQWRKB3R3F0AZ46YS>
        <Suites [
          <Suite #governance-integration { name = "治理集成" } (
            <Cases [
              <Case #snapshot-includes-rules (
                <Given ?01M1W0XR6FQWRKB3R3F0AZ46YT>
                已定义存在规则且应用一次 schema 迁移
                </?01M1W0XR6FQWRKB3R3F0AZ46YT>
                <When ?01M1W0XR6FQWRKB3R3F0AZ46YV>
                读取目标版本 schema snapshot
                </?01M1W0XR6FQWRKB3R3F0AZ46YV>
                <Then ?01M1W0XR6FQWRKB3R3F0AZ46YW>
                snapshot 包含 om_existential_rule_def 的规则定义
                </?01M1W0XR6FQWRKB3R3F0AZ46YW>
              )>
              <Case #rollback-restores-rules (
                <Given ?01M1W0XR6FQWRKB3R3F0AZ46YX>
                v1 定义了规则 r1，v2 修改了 r1 的 spec
                </?01M1W0XR6FQWRKB3R3F0AZ46YX>
                <When ?01M1W0XR6FQWRKB3R3F0AZ46YY>
                调用 rollbackSchema(runner, 1)
                </?01M1W0XR6FQWRKB3R3F0AZ46YY>
                <Then ?01M1W0XR6FQWRKB3R3F0AZ46YZ>
                r1 恢复为 v1 时的定义
                </?01M1W0XR6FQWRKB3R3F0AZ46YZ>
              )>
              <Case #alias-keeps-rule-working-after-rename (
                <Given ?01M1W0XR6FQWRKB3R3F0AZ46Z0>
                规则引用关系 has_shipment，schema 迁移将其重命名为 fulfilled_by
                </?01M1W0XR6FQWRKB3R3F0AZ46Z0>
                <When ?01M1W0XR6FQWRKB3R3F0AZ46Z1>
                调用 checkExistentialRules(runner)
                </?01M1W0XR6FQWRKB3R3F0AZ46Z1>
                <Then ?01M1W0XR6FQWRKB3R3F0AZ46Z2>
                规则经 alias 解析继续正确检测违例
                </?01M1W0XR6FQWRKB3R3F0AZ46Z2>
              )>
              <Case #backward-compatible-when-unused (
                <Given ?01M1W0XR6FQWRKB3R3F0AZ46Z3>
                数据库已 initSchema 但未定义任何存在规则
                </?01M1W0XR6FQWRKB3R3F0AZ46Z3>
                <When ?01M1W0XR6FQWRKB3R3F0AZ46Z4>
                调用既有 API（findByType / getEntityView / setProperty / linkEntities 等）
                </?01M1W0XR6FQWRKB3R3F0AZ46Z4>
                <Then ?01M1W0XR6FQWRKB3R3F0AZ46Z5>
                行为与引入存在规则子系统前一致
                </?01M1W0XR6FQWRKB3R3F0AZ46Z5>
              )>
            ]>
          )>
        ]>
      )>
    )>
  ]>
)>
