<BehaviorPatch #track.r_2_0_2_6_-_0_3_-_0_2_-_0_8_1_1_-_a_d_d_-_s_c_h_e_m_a_-_v_e_r_s_i_o_n_i_n_g_-_p_e_r_m_i_s_s_i_o_n_-_i_n_t_e_g_r_a_t_i_o_n.behavior_patch.depa-ontology apiVersion="codument.tech/v1alpha1" version="1" { capability = "depa-ontology" } (
  <Mutations [
    <Upsert { selector = "behavior://depa-ontology/requirements/add-schema-versioning-permission-integration-r-fa3db11ccc" } (
      <Requirement #add-schema-versioning-permission-integration-r-fa3db11ccc (
        <Statement ?01M1W0XR68QKE556QK98B2TC75>
        系统 SHALL 支持为本体 schema 维护版本状态与历史记录。版本化元数据 SHALL 与现有 `om_type`/`om_attr_def`/`om_rel_def` 等 schema 关系并存，且不要求将版本号加入现有 schema 关系的 key 列（避免破坏性变更）。
        </?01M1W0XR68QKE556QK98B2TC75>
        <Suites [
          <Suite #add-schema-versioning-permission-integration-r-fa3db11ccc-suite { name = "Schema 版本化元数据" } (
            <Cases [
              <Case #add-schema-versioning-permission-integration-r-fa3db11ccc-c-b8492d295b { name = "初始化 schema 时创建版本化元数据" } (
                <Given ?01M1W0XR68QKE556QK98B2TC76>
                一个新的空数据库实例
                </?01M1W0XR68QKE556QK98B2TC76>
                <When ?01M1W0XR68QKE556QK98B2TC77>
                调用 `initSchema(runner)`
                </?01M1W0XR68QKE556QK98B2TC77>
                <Then ?01M1W0XR68QKE556QK98B2TC78>
                系统创建版本化元数据关系（如 schema state / version / migration / snapshot / alias 映射）；设定 `current_version = 1`
                </?01M1W0XR68QKE556QK98B2TC78>
              )>
              <Case #add-schema-versioning-permission-integration-r-fa3db11ccc-c-873d6e4b68 { name = "查询当前 schema 状态" } (
                <Given ?01M1W0XR68QKE556QK98B2TC79>
                数据库已初始化 schema
                </?01M1W0XR68QKE556QK98B2TC79>
                <When ?01M1W0XR68QKE556QK98B2TC7A>
                调用 `getSchemaState(runner)`
                </?01M1W0XR68QKE556QK98B2TC7A>
                <Then ?01M1W0XR68QKE556QK98B2TC7B>
                返回 `{ currentVersion, checksum }`
                </?01M1W0XR68QKE556QK98B2TC7B>
              )>
            ]>
          )>
        ]>
      )>
    )>
    <Upsert { selector = "behavior://depa-ontology/requirements/add-schema-versioning-permission-integration-r-06553bd84e" } (
      <Requirement #add-schema-versioning-permission-integration-r-06553bd84e (
        <Statement ?01M1W0XR68QKE556QK98B2TC7C>
        系统 SHALL 支持以结构化迁移规范（migration spec）应用 schema 变更，并记录迁移历史。迁移记录 SHALL 可用于审计与回滚。
        </?01M1W0XR68QKE556QK98B2TC7C>
        <Suites [
          <Suite #add-schema-versioning-permission-integration-r-06553bd84e-suite { name = "Schema 迁移（Migration）记录与应用" } (
            <Cases [
              <Case #add-schema-versioning-permission-integration-r-06553bd84e-c-27704ae533 { name = "应用迁移并记录历史" } (
                <Given ?01M1W0XR68QKE556QK98B2TC7D>
                当前 `current_version = 1`
                </?01M1W0XR68QKE556QK98B2TC7D>
                <When ?01M1W0XR68QKE556QK98B2TC7E>
                调用 `applySchemaMigration(runner, spec)` 将 schema 升级到版本 2
                </?01M1W0XR68QKE556QK98B2TC7E>
                <Then ?01M1W0XR68QKE556QK98B2TC7F>
                系统更新 `current_version = 2`；系统写入一条迁移记录（from/to/applied_at/status/summary）；系统为目标版本写入 schema snapshot
                </?01M1W0XR68QKE556QK98B2TC7F>
              )>
              <Case #add-schema-versioning-permission-integration-r-06553bd84e-c-9cad5308c3 { name = "多版本共存通过别名解析实现" } (
                <Given ?01M1W0XR68QKE556QK98B2TC7G>
                schema 从 v1 演进到 v2，存在重命名
                </?01M1W0XR68QKE556QK98B2TC7G>
                <When ?01M1W0XR68QKE556QK98B2TC7H>
                使用旧名称与新名称调用 API（读/写）
                </?01M1W0XR68QKE556QK98B2TC7H>
                <Then ?01M1W0XR68QKE556QK98B2TC7J>
                系统通过别名映射解析到 canonical 名称；API 对外返回 canonical 名称
                </?01M1W0XR68QKE556QK98B2TC7J>
              )>
            ]>
          )>
        ]>
      )>
    )>
    <Upsert { selector = "behavior://depa-ontology/requirements/add-schema-versioning-permission-integration-r-6a5729d39f" } (
      <Requirement #add-schema-versioning-permission-integration-r-6a5729d39f (
        <Statement ?01M1W0XR68QKE556QK98B2TC7K>
        系统 SHALL 支持类型/关系/属性的重命名，并保证旧名称在升级后仍可用于读写（通过别名解析）。
        </?01M1W0XR68QKE556QK98B2TC7K>
        <Suites [
          <Suite #add-schema-versioning-permission-integration-r-6a5729d39f-suite { name = "重命名兼容（Alias）" } (
            <Cases [
              <Case #add-schema-versioning-permission-integration-r-6a5729d39f-c-f5df263497 { name = "属性重命名后旧名称仍可读取" } (
                <Given ?01M1W0XR68QKE556QK98B2TC7M>
                v1 中属性名为 `Employee.department`；v2 将该属性重命名为 `Employee.org_unit`
                </?01M1W0XR68QKE556QK98B2TC7M>
                <When ?01M1W0XR68QKE556QK98B2TC7N>
                调用 `getProperty(runner, empId, &apos;department&apos;)`
                </?01M1W0XR68QKE556QK98B2TC7N>
                <Then ?01M1W0XR68QKE556QK98B2TC7P>
                返回与 `getProperty(runner, empId, &apos;org_unit&apos;)` 一致的结果
                </?01M1W0XR68QKE556QK98B2TC7P>
              )>
              <Case #add-schema-versioning-permission-integration-r-6a5729d39f-c-aa4ce6f925 { name = "旧名称写入被规范化为 canonical" } (
                <Given ?01M1W0XR68QKE556QK98B2TC7Q>
                v2 中 `Employee.department` 是 `Employee.org_unit` 的 alias
                </?01M1W0XR68QKE556QK98B2TC7Q>
                <When ?01M1W0XR68QKE556QK98B2TC7R>
                调用 `setProperty(runner, empId, &apos;department&apos;, &apos;X&apos;)`
                </?01M1W0XR68QKE556QK98B2TC7R>
                <Then ?01M1W0XR68QKE556QK98B2TC7S>
                系统写入 canonical 属性 `org_unit`
                </?01M1W0XR68QKE556QK98B2TC7S>
              )>
              <Case #add-schema-versioning-permission-integration-r-6a5729d39f-c-2abd0bb26f { name = "canonical 与 alias 同时存在时的确定性优先级" } (
                <Given ?01M1W0XR68QKE556QK98B2TC7T>
                同一语义字段同时存在 canonical 与 alias 的值
                </?01M1W0XR68QKE556QK98B2TC7T>
                <When ?01M1W0XR68QKE556QK98B2TC7V>
                调用 `getProperty`（或 `getPropertyAsOf`）
                </?01M1W0XR68QKE556QK98B2TC7V>
                <Then ?01M1W0XR68QKE556QK98B2TC7W>
                系统返回 canonical 值；系统可提供诊断信息提示存在重复
                </?01M1W0XR68QKE556QK98B2TC7W>
              )>
            ]>
          )>
        ]>
      )>
    )>
    <Upsert { selector = "behavior://depa-ontology/requirements/add-schema-versioning-permission-integration-r-c014c90a6b" } (
      <Requirement #add-schema-versioning-permission-integration-r-c014c90a6b (
        <Statement ?01M1W0XR68QKE556QK98B2TC7X>
        系统 SHALL 支持将 schema 回滚到历史版本。回滚 SHALL 恢复 schema 定义与别名映射；回滚不要求对实例数据做 destructive delete。
        </?01M1W0XR68QKE556QK98B2TC7X>
        <Suites [
          <Suite #add-schema-versioning-permission-integration-r-c014c90a6b-suite { name = "Schema 回滚/降级（Rollback/Downgrade）" } (
            <Cases [
              <Case #add-schema-versioning-permission-integration-r-c014c90a6b-c-601f69dbfb { name = "严格回滚在不兼容时阻止" } (
                <Given ?01M1W0XR68QKE556QK98B2TC7Y>
                v3 对 `required`/`valueType` 做了收紧
                </?01M1W0XR68QKE556QK98B2TC7Y>
                <When ?01M1W0XR68QKE556QK98B2TC7Z>
                调用 `rollbackSchema(runner, targetVersion, { strict: true })`；回滚会导致现有实例数据不满足目标版本约束
                </?01M1W0XR68QKE556QK98B2TC7Z>
                <Then ?01M1W0XR68QKE556QK98B2TC80>
                回滚失败并返回包含 entityId/field 的诊断
                </?01M1W0XR68QKE556QK98B2TC80>
              )>
              <Case #add-schema-versioning-permission-integration-r-c014c90a6b-c-78e861974b { name = "强制回滚允许但返回诊断" } (
                <Given ?01M1W0XR68QKE556QK98B2TC81>
                同上
                </?01M1W0XR68QKE556QK98B2TC81>
                <When ?01M1W0XR68QKE556QK98B2TC82>
                调用 `rollbackSchema(runner, targetVersion, { strict: false })`
                </?01M1W0XR68QKE556QK98B2TC82>
                <Then ?01M1W0XR68QKE556QK98B2TC83>
                回滚成功；返回诊断摘要供后续修复
                </?01M1W0XR68QKE556QK98B2TC83>
              )>
            ]>
          )>
        ]>
      )>
    )>
    <Upsert { selector = "behavior://depa-ontology/requirements/add-schema-versioning-permission-integration-r-2e11ee5d01" } (
      <Requirement #add-schema-versioning-permission-integration-r-2e11ee5d01 (
        <Statement ?01M1W0XR68QKE556QK98B2TC84>
        系统 SHALL 支持以下 schema 演进类型，并在可能破坏兼容性时提供 preflight 校验： - 新增属性/关系 - 重命名属性/关系 - 修改 `valueType` / `required` - 修改类型继承（parent_type / mixins）
        </?01M1W0XR68QKE556QK98B2TC84>
        <Suites [
          <Suite #add-schema-versioning-permission-integration-r-2e11ee5d01-suite { name = "valueType/required/继承变更的预检与迁移" } (
            <Cases [
              <Case #add-schema-versioning-permission-integration-r-2e11ee5d01-c-c5e724b029 { name = "valueType 变更必须通过预检或显式转换" } (
                <Given ?01M1W0XR68QKE556QK98B2TC85>
                某属性从 String 变更为 Number
                </?01M1W0XR68QKE556QK98B2TC85>
                <When ?01M1W0XR68QKE556QK98B2TC86>
                应用迁移（strict precheck）
                </?01M1W0XR68QKE556QK98B2TC86>
                <Then ?01M1W0XR68QKE556QK98B2TC87>
                若存在不可转换的旧值，迁移失败并返回诊断
                </?01M1W0XR68QKE556QK98B2TC87>
              )>
              <Case #add-schema-versioning-permission-integration-r-2e11ee5d01-c-67d66cbfa2 { name = "required 收紧支持 backfill 后收紧" } (
                <Given ?01M1W0XR68QKE556QK98B2TC88>
                v1 属性 `Employee.level` 为非必填
                </?01M1W0XR68QKE556QK98B2TC88>
                <When ?01M1W0XR68QKE556QK98B2TC89>
                迁移步骤包含“backfill 默认值”并随后将 required 设为 true
                </?01M1W0XR68QKE556QK98B2TC89>
                <Then ?01M1W0XR68QKE556QK98B2TC8A>
                迁移成功且后续写入/校验遵循新的 required 规则
                </?01M1W0XR68QKE556QK98B2TC8A>
              )>
              <Case #add-schema-versioning-permission-integration-r-2e11ee5d01-c-5f4c2af821 { name = "继承变更必须避免循环与冲突" } (
                <Given ?01M1W0XR68QKE556QK98B2TC8B>
                schema 修改 parent_type 或 mixins
                </?01M1W0XR68QKE556QK98B2TC8B>
                <When ?01M1W0XR68QKE556QK98B2TC8C>
                应用迁移
                </?01M1W0XR68QKE556QK98B2TC8C>
                <Then ?01M1W0XR68QKE556QK98B2TC8D>
                系统检测并阻止继承循环；系统检测并阻止继承属性 valueType/required 冲突
                </?01M1W0XR68QKE556QK98B2TC8D>
              )>
            ]>
          )>
        ]>
      )>
    )>
    <Upsert { selector = "behavior://depa-ontology/requirements/add-schema-versioning-permission-integration-r-406f89bac9" } (
      <Requirement #add-schema-versioning-permission-integration-r-406f89bac9 (
        <Statement ?01M1W0XR68QKE556QK98B2TC8E>
        系统 SHALL 新增可选的权限能力，用于对本体实体/属性/关系执行访问控制。 权限模型 SHALL 同时支持： - **Relation-path 推导**：用本体关系路径限定可见实体范围（scope） - **ABAC 细化**：在 scope 内按 subject/resource attributes 与策略规则决定 allow/deny，并支持字段级隐藏
        </?01M1W0XR68QKE556QK98B2TC8E>
        <Suites [
          <Suite #add-schema-versioning-permission-integration-r-406f89bac9-suite { name = "本体论 + 权限集成（Hybrid ABAC + Relation-Path）" } (
            <Cases [
              <Case #add-schema-versioning-permission-integration-r-406f89bac9-c-1003d49a7f { name = "checkAccess 返回 allow/deny 与解释" } (
                <Given ?01M1W0XR68QKE556QK98B2TC8F>
                存在 subject（用户）与 resource（本体实体）
                </?01M1W0XR68QKE556QK98B2TC8F>
                <When ?01M1W0XR68QKE556QK98B2TC8G>
                调用 `checkAccess(runner, { subjectId, action, resourceId })`
                </?01M1W0XR68QKE556QK98B2TC8G>
                <Then ?01M1W0XR68QKE556QK98B2TC8H>
                返回 `{ allow, matchedPolicies, explanation }`；explanation 包含：命中的 path witness（若适用）与 ABAC 条件对比
                </?01M1W0XR68QKE556QK98B2TC8H>
              )>
              <Case #add-schema-versioning-permission-integration-r-406f89bac9-c-07e2eaf91b { name = "权限策略对 schema 重命名保持稳定" } (
                <Given ?01M1W0XR68QKE556QK98B2TC8J>
                策略引用了属性/关系名
                </?01M1W0XR68QKE556QK98B2TC8J>
                <When ?01M1W0XR68QKE556QK98B2TC8K>
                schema 迁移发生重命名
                </?01M1W0XR68QKE556QK98B2TC8K>
                <Then ?01M1W0XR68QKE556QK98B2TC8M>
                策略引用通过 alias 解析仍可工作
                </?01M1W0XR68QKE556QK98B2TC8M>
              )>
              <Case #add-schema-versioning-permission-integration-r-406f89bac9-c-938c06256d { name = "权限能力默认不影响既有调用方" } (
                <Given ?01M1W0XR68QKE556QK98B2TC8N>
                未显式启用 policy
                </?01M1W0XR68QKE556QK98B2TC8N>
                <When ?01M1W0XR68QKE556QK98B2TC8P>
                现有 API（如 `getEntityView`/`findByType`/`runQuery`）被调用
                </?01M1W0XR68QKE556QK98B2TC8P>
                <Then ?01M1W0XR68QKE556QK98B2TC8Q>
                行为与启用权限前一致
                </?01M1W0XR68QKE556QK98B2TC8Q>
              )>
            ]>
          )>
        ]>
      )>
    )>
    <Upsert { selector = "behavior://depa-ontology/requirements/add-schema-versioning-permission-integration-r-b8814c155d" } (
      <Requirement #add-schema-versioning-permission-integration-r-b8814c155d (
        <Statement ?01M1W0XR68QKE556QK98B2TC8R>
        系统 SHALL 在 viz 前端新增两个新的 top-nav tab/page（不修改现有 `/permission` demo 的业务逻辑与交互）： - **本体论 + 权限**：展示 Hybrid ABAC + Relation-path 对本体数据的访问控制与解释 - **Schema 版本化**：展示 schema 版本列表、diff、应用迁移、回滚的演示
        </?01M1W0XR68QKE556QK98B2TC8R>
        <Suites [
          <Suite #add-schema-versioning-permission-integration-r-b8814c155d-suite { name = "Viz 新增演示 Tab（不改旧权限 demo）" } (
            <Cases [
              <Case #add-schema-versioning-permission-integration-r-b8814c155d-c-9a6df1c9f5 { name = "旧权限 demo 不受影响" } (
                <Given ?01M1W0XR68QKE556QK98B2TC8S>
                用户访问 `/permission`
                </?01M1W0XR68QKE556QK98B2TC8S>
                <When ?01M1W0XR68QKE556QK98B2TC8T>
                选择 RBAC/ABAC/Timeline 权限模型并执行查询
                </?01M1W0XR68QKE556QK98B2TC8T>
                <Then ?01M1W0XR68QKE556QK98B2TC8V>
                行为与本 track 前一致
                </?01M1W0XR68QKE556QK98B2TC8V>
              )>
              <Case #add-schema-versioning-permission-integration-r-b8814c155d-c-8c64552e77 { name = "新增本体论+权限页面可运行并展示解释" } (
                <Given ?01M1W0XR68QKE556QK98B2TC8W>
                用户进入新页面
                </?01M1W0XR68QKE556QK98B2TC8W>
                <When ?01M1W0XR68QKE556QK98B2TC8X>
                选择 subject/action/resource 并执行检查
                </?01M1W0XR68QKE556QK98B2TC8X>
                <Then ?01M1W0XR68QKE556QK98B2TC8Y>
                页面展示 allow/deny 与解释信息
                </?01M1W0XR68QKE556QK98B2TC8Y>
              )>
              <Case #add-schema-versioning-permission-integration-r-b8814c155d-c-ca77e935e4 { name = "新增 schema 版本化页面可运行迁移/回滚演示" } (
                <Given ?01M1W0XR68QKE556QK98B2TC8Z>
                用户进入新页面
                </?01M1W0XR68QKE556QK98B2TC8Z>
                <When ?01M1W0XR68QKE556QK98B2TC90>
                应用一次 schema 迁移并查看 diff；触发一次回滚
                </?01M1W0XR68QKE556QK98B2TC90>
                <Then ?01M1W0XR68QKE556QK98B2TC91>
                页面展示版本切换与状态变化
                </?01M1W0XR68QKE556QK98B2TC91>
              )>
            ]>
          )>
        ]>
      )>
    )>
    <Upsert { selector = "behavior://depa-ontology/requirements/add-schema-versioning-permission-integration-r-678787c9cc" } (
      <Requirement #add-schema-versioning-permission-integration-r-678787c9cc (
        <Statement ?01M1W0XR68QKE556QK98B2TC92>
        系统 SHALL 在 `/governance` 页面内提供清晰的子 Tabs，将“数据准备（seed/初始化）”与“权限查询（checkAccess/explain）”分离，并允许用户在页面中查看与编辑演示的初始数据，再以编辑后的数据重新初始化演示环境。
        </?01M1W0XR68QKE556QK98B2TC92>
        <Suites [
          <Suite #add-schema-versioning-permission-integration-r-678787c9cc-suite { name = "Governance 页面 Tabs 与数据准备（可编辑）" } (
            <Cases [
              <Case #add-schema-versioning-permission-integration-r-678787c9cc-c-36590aadfd { name = "/governance 页面包含两个子 tab" } (
                <Given ?01M1W0XR68QKE556QK98B2TC93>
                用户进入 `/governance`
                </?01M1W0XR68QKE556QK98B2TC93>
                <When ?01M1W0XR68QKE556QK98B2TC94>
                legacy source did not declare this GWT field
                </?01M1W0XR68QKE556QK98B2TC94>
                <Then ?01M1W0XR68QKE556QK98B2TC95>
                页面包含至少两个子 tab：`数据准备` 与 `权限查询`；`权限查询` tab 中可执行权限检查并展示 allow/deny 与解释；切换 tab 不应丢失已输入的 subjectId/resourceId/action（除非用户显式重置）
                </?01M1W0XR68QKE556QK98B2TC95>
              )>
              <Case #add-schema-versioning-permission-integration-r-678787c9cc-c-e1e36200fa { name = "数据准备 tab 显示默认 seed 数据并允许编辑" } (
                <Given ?01M1W0XR68QKE556QK98B2TC96>
                用户进入 `/governance` 的 `数据准备` tab
                </?01M1W0XR68QKE556QK98B2TC96>
                <When ?01M1W0XR68QKE556QK98B2TC97>
                legacy source did not declare this GWT field
                </?01M1W0XR68QKE556QK98B2TC97>
                <Then ?01M1W0XR68QKE556QK98B2TC98>
                页面展示一份默认的 seed 数据模板；该模板以可视化表格/工作表（类似“对象建模分析”页面顶部表格）展示，使用户可直接查看初始数据；用户可修改该数据（实体/属性/边/策略等）
                </?01M1W0XR68QKE556QK98B2TC98>
              )>
              <Case #add-schema-versioning-permission-integration-r-678787c9cc-c-3a0cbb8a14 { name = "编辑后的数据可用于重新初始化演示环境" } (
                <Given ?01M1W0XR68QKE556QK98B2TC99>
                用户在 `数据准备` tab 中对 seed 数据进行了修改
                </?01M1W0XR68QKE556QK98B2TC99>
                <When ?01M1W0XR68QKE556QK98B2TC9A>
                用户点击“重新初始化/应用”
                </?01M1W0XR68QKE556QK98B2TC9A>
                <Then ?01M1W0XR68QKE556QK98B2TC9B>
                后端使用更新后的 seed 数据重新初始化演示数据与策略；后续在 `权限查询` tab 运行时使用新数据
                </?01M1W0XR68QKE556QK98B2TC9B>
              )>
              <Case #add-schema-versioning-permission-integration-r-678787c9cc-c-ca2dbe3bd4 { name = "兼容旧 seed 调用" } (
                <Given ?01M1W0XR68QKE556QK98B2TC9C>
                现有调用方以旧方式调用 `POST /api/governance/seed`（无请求体）
                </?01M1W0XR68QKE556QK98B2TC9C>
                <When ?01M1W0XR68QKE556QK98B2TC9D>
                触发 seed
                </?01M1W0XR68QKE556QK98B2TC9D>
                <Then ?01M1W0XR68QKE556QK98B2TC9E>
                系统仍使用默认 seed 数据初始化演示环境
                </?01M1W0XR68QKE556QK98B2TC9E>
              )>
            ]>
          )>
        ]>
      )>
    )>
